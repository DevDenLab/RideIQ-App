<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_hint"
        android:textSize="14sp"
        android:paddingBottom="6dp" />

    <EditText
        android:id="@+id/startField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/start_hint"
        android:inputType="textPostalAddress"
        android:maxLines="1"
        android:imeOptions="actionNext"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <EditText
            android:id="@+id/destField"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/dest_hint"
            android:inputType="textPostalAddress"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:textSize="14sp" />
        <Button
            android:id="@+id/goBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="6dp"
            android:text="@string/route_btn"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/suggestionsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pickupText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pickup_waiting"
        android:textSize="13sp"
        android:textColor="#2E7D32"
        android:paddingBottom="2dp" />

    <TextView
        android:id="@+id/dropoffText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dropoff_hint"
        android:textSize="13sp"
        android:textColor="#C62828"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/navBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E6FEB"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="17sp"
        android:padding="10dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/optionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="6dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/optionsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <Button android:id="@+id/modeBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginEnd="4dp"
            android:text="@string/mode_drive" android:textSize="12sp" />
        <Button android:id="@+id/myLocBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginEnd="4dp"
            android:text="@string/my_location" android:textSize="12sp" />
        <Button android:id="@+id/satBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:text="@string/toggle_satellite" android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="@string/start_trip"
            android:enabled="false" />
        <Button
            android:id="@+id/resetBtn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/reset_map" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:menu="@menu/bottom_nav"
        app:labelVisibilityMode="labeled"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
