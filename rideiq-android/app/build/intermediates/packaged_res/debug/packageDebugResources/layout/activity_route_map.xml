<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/map_hint"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/from_label" android:layout_gravity="center_vertical" />
        <Spinner android:id="@+id/fromSpinner" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/to_label" android:layout_gravity="center_vertical"
            android:paddingStart="6dp" />
        <Spinner android:id="@+id/toSpinner" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">
        <Button android:id="@+id/routeLmBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginEnd="4dp"
            android:text="@string/route_landmarks" android:textSize="12sp" />
        <Button android:id="@+id/myLocBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
            android:text="@string/my_location" android:textSize="12sp" />
        <Button android:id="@+id/satBtn" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:text="@string/toggle_satellite" android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/resetBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_map"
        android:layout_marginTop="8dp" />
</LinearLayout>
