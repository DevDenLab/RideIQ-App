<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Floating search card (top) -->
        <LinearLayout
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:padding="12dp">

            <TextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map_hint"
                android:textSize="12sp"
                android:textColor="#666666"
                android:paddingBottom="6dp" />

            <EditText
                android:id="@+id/startField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/start_hint"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:imeOptions="actionNext"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/destField"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:hint="@string/dest_hint"
                    android:inputType="textPostalAddress"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/goBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="6dp"
                    android:text="@string/route_btn"
                    android:textSize="12sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/suggestionsList"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#FFFFFF"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                <Button android:id="@+id/driveBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                    android:text="@string/seg_drive" android:textSize="13sp"
                    style="?android:attr/borderlessButtonStyle" />
                <Button android:id="@+id/walkBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="6dp"
                    android:text="@string/seg_walk" android:textSize="13sp"
                    style="?android:attr/borderlessButtonStyle" />
                <Button android:id="@+id/transitModeBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/seg_transit" android:textSize="13sp"
                    style="?android:attr/borderlessButtonStyle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <Button android:id="@+id/myLocBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="4dp"
                    android:text="@string/my_location" android:textSize="11sp" />
                <Button android:id="@+id/satBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/toggle_satellite" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Turn-by-turn banner (over the search card during navigation) -->
        <TextView
            android:id="@+id/navBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:background="#1E6FEB"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:padding="12dp"
            android:elevation="8dp"
            android:visibility="gone" />

        <!-- Floating route/detail panel (bottom) -->
        <LinearLayout
            android:id="@+id/routePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:padding="12dp">

            <TextView
                android:id="@+id/pickupText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pickup_waiting"
                android:textSize="13sp"
                android:textColor="#2E7D32"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/dropoffText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dropoff_hint"
                android:textSize="13sp"
                android:textColor="#C62828"
                android:paddingBottom="6dp" />

            <HorizontalScrollView
                android:id="@+id/optionsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/optionsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">
                <Button android:id="@+id/directionsBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="4dp"
                    android:text="@string/directions_btn" android:textSize="11sp" />
                <Button android:id="@+id/streetViewBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginEnd="4dp"
                    android:text="@string/street_view_btn" android:textSize="11sp" />
                <Button android:id="@+id/transitBtn" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/transit_btn" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/startBtn"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/start_trip"
                    android:enabled="false" />
                <Button
                    android:id="@+id/resetBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_map" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
